# ============================================================================
# LMELP Stack - Template .env pour déploiement NAS Synology
# ============================================================================
# Pré-rempli avec les chemins et décisions actés pour la migration NAS
# (voir issue #47 et docs/user/migration-nas.md).
#
# Utilisation :
#   cp .env.nas.example .env.nas
#   # compléter les clés API ci-dessous (à recopier depuis votre .env laptop)
#   # puis transférer .env.nas sur le NAS en tant que .env
#
# ⚠️  DO NOT commit .env.nas to version control (il contient des clés API sensibles) —
#     déjà couvert par .gitignore.
# ⚠️  IMPORTANT Portainer : les chemins doivent rester ABSOLUS (déjà le cas ici) —
#     Portainer résout les chemins relatifs depuis son propre répertoire de travail,
#     pas depuis celui du docker-compose.yml (piège documenté dans CLAUDE.md).
# ============================================================================

# ============================================================================
# MongoDB Configuration
# ============================================================================
# Port exposé sur l'hôte
MONGO_PORT=27018

# Nom de la base de données
MONGO_DATABASE=masque_et_la_plume

# --- Variables pour logs ---
DB_LOGS=true

# ============================================================================
# LLM API Keys - AU MOINS UNE CLÉ REQUISE
# ============================================================================
# À recopier depuis le .env du laptop (non versionné).

# --- Google Gemini (recommandé) ---
GEMINI_API_KEY=

# --- Google Vertex AI ---
GOOGLE_PROJECT_ID=
GOOGLE_AUTH_FILE=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Azure OpenAI ---
AZURE_API_KEY=
AZURE_ENDPOINT=
AZURE_API_VERSION=
AZURE_DEPLOYMENT_NAME=

# --- LiteLLM (modèles locaux) ---
LITELLM_API_KEY=

# ============================================================================
# Google Custom Search (optionnel)
# ============================================================================
GOOGLE_CUSTOM_SEARCH_API_KEY=
SEARCH_ENGINE_ID=

# ============================================================================
# LMELP Application Configuration
# ============================================================================
RSS_LMELP_URL=https://radiofrance-podcast.net/podcast09/rss_14007.xml
LMELP_MODE=web
LMELP_PORT=8501

# ============================================================================
# Back-Office Configuration
# ============================================================================
BACKEND_PORT=8000
# ⚠️ 8080 est souvent déjà pris par un autre service NAS (ex: speedtest) —
# vérifier les ports déjà utilisés (Portainer → Containers, ou reverse proxy DSM)
# avant de déployer, et adapter si besoin.
FRONTEND_PORT=8081

# ============================================================================
# Chemins des Volumes — chemins absolus NAS (obligatoire pour Portainer)
# ============================================================================
# Arborescence créée via DSM File Station (ou en SSH) :
#   /docker/lmelp/{mongodb,backups,audios,logs,mongodb-logs,cache/babelio}
# Chemin absolu réel attendu par Docker (le préfixe /volume1 n'apparaît pas dans
# l'interface DSM File Station, mais il est nécessaire ici) :
#
# ⚠️  mongodb-logs ne doit PAS être un sous-dossier de logs/ : le conteneur
# lmelp chowne récursivement son propre volume LOG_PATH au démarrage
# (PUID/PGID), ce qui écraserait l'ownership mongodb des logs Mongo s'ils
# étaient imbriqués dedans (issue #51).

MONGO_DATA_PATH=/volume1/docker/lmelp/mongodb
BACKUP_PATH=/volume1/docker/lmelp/backups
AUDIO_PATH=/volume1/docker/lmelp/audios
LOG_PATH=/volume1/docker/lmelp/logs
MONGO_LOG_PATH=/volume1/docker/lmelp/mongodb-logs
BABELIO_CACHE_PATH=/volume1/docker/lmelp/cache/babelio

# ============================================================================
# Calibre Integration
# ============================================================================
# Bibliothèque CWA (Calibre-Web-Automated) déjà présente sur ce NAS — cf. issue #47 §5.
CALIBRE_HOST_PATH=/volume1/docker/calibre-web-automated/books

# Tag de bibliothèque virtuelle Calibre (optionnel)
# CALIBRE_VIRTUAL_LIBRARY_TAG=guillaume

# ============================================================================
# Configuration Babelio
# ============================================================================
BABELIO_FAIR_SEC=2.0
BABELIO_CACHE_DAY=30

# ============================================================================
# Backup Configuration
# ============================================================================
BACKUP_RETENTION_WEEKS=7

# ============================================================================
# LMELP Export Service (Optionnel — export Android via ADB)
# ============================================================================
# À valider en conditions réelles sur le NAS (cf. issue #47 §4) : nécessite un
# serveur ADB joignable en TCP par le conteneur (NAS via SSH + platform-tools,
# ou conteneur ADB dédié).
ADB_HOST=host-gateway
ADB_PORT=5037

# Token GitHub pour la publication automatique de release (optionnel).
# Requis uniquement par 'export-and-publish-release' (gh release upload vers
# la release 'data-latest' de castorfou/lmelp-mobile) — cf. issue #56.
# Scope minimal : PAT fine-grained limité au repo castorfou/lmelp-mobile,
# permission "Contents: Read and write". Laisser vide pour désactiver.
GH_TOKEN=

# Logs du job anacron de lmelp-export (publish-data-release.log).
# ⚠️  Chemin absolu ABSOLUMENT distinct de LOG_PATH : ne pas imbriquer
# (même piège que MONGO_LOG_PATH, cf. issue #51 et #56).
LMELP_EXPORT_LOG_PATH=/volume1/docker/lmelp/lmelp-export-logs

# ============================================================================
# PUID / PGID — Propriétaire des fichiers créés par les conteneurs lmelp et backend
# ============================================================================
# Valeur : l'UID/GID réel de votre utilisateur sur CE NAS (ex: `id guillaume` en SSH,
# ou visible dans DSM → Panneau de configuration → Utilisateur), pour que les fichiers
# audios/cache écrits par les conteneurs restent lisibles/supprimables depuis DSM sans
# être root:root. Les fichiers root:root d'un déploiement précédent sont repris
# automatiquement au redémarrage du conteneur.
PUID=1027
PGID=1027
